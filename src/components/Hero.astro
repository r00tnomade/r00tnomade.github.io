---
import { getImage } from 'astro:assets';
import { hero, site } from '../content/site';
import { resolveImage } from '../lib/images';
import Nav from './Nav.astro';

const [desk, mobile] = await Promise.all([resolveImage(hero.image.src), resolveImage(hero.mobileImage.src)]);
// Always include the file's own width, so the full-resolution image is served.
const sizes = (img: { width: number }, ws: number[]) => [...new Set([...ws.filter((w) => w < img.width), img.width])];
const quality = 92;

const [deskAvif, deskWebp, mobAvif, mobWebp, fallback] = await Promise.all([
  getImage({ src: desk, widths: sizes(desk, [1280]), format: 'avif', quality }),
  getImage({ src: desk, widths: sizes(desk, [1280]), format: 'webp', quality }),
  getImage({ src: mobile, widths: sizes(mobile, [640]), format: 'avif', quality }),
  getImage({ src: mobile, widths: sizes(mobile, [640]), format: 'webp', quality }),
  getImage({ src: desk, width: desk.width, format: 'webp', quality }),
]);

// Two lines on narrow screens; each word animates in on its own.
const words = site.name.toUpperCase().split(' ');
const lines = [words.slice(0, -1), words.slice(-1)];
let n = 0;
---

<section class="hero" id="top" aria-label="Introduction">
  <picture class="hero__media">
    <source media="(max-width: 699px)" srcset={mobAvif.srcSet.attribute} type="image/avif" />
    <source media="(max-width: 699px)" srcset={mobWebp.srcSet.attribute} type="image/webp" />
    <source srcset={deskAvif.srcSet.attribute} type="image/avif" sizes="100vw" />
    <source srcset={deskWebp.srcSet.attribute} type="image/webp" sizes="100vw" />
    <img
      src={fallback.src}
      alt=""
      width={desk.width}
      height={desk.height}
      fetchpriority="high"
      decoding="async"
      style={`--pos: ${hero.image.position ?? 'center'}; --pos-m: ${hero.mobileImage.position ?? 'center'}`}
    />
  </picture>

  <Nav tone={hero.navTone} />

  <div class="hero__shade" aria-hidden="true"></div>

  <h1 class="hero__name serif" aria-label={site.name}>
    {
      lines.map((line) => (
        <span class="hero__row" aria-hidden="true">
          {line.map((w) => (
            <span class="hero__word" style={`--i:${n++}`}>
              {w}
            </span>
          ))}
        </span>
      ))
    }
  </h1>

  <p class="hero__line">{hero.line}</p>

  <a class="hero__cue" href="#main" aria-label="Scroll to content">
    <svg width="26" height="24" viewBox="0 0 26 24" fill="none" aria-hidden="true">
      <path d="M3 3l10 7 10-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />
      <path d="M3 12l10 7 10-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--c-black);
  }

  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
    animation: hero-in 2.8s var(--ease) both;
    /* Scroll parallax drives `translate`, so it composes with the entrance scale. */
    translate: 0 calc(var(--p, 0) * 18vh);
  }

  /* Fade the photograph into the black page below. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 58%, rgba(0, 0, 0, 0.55) 82%, #000 100%);
    pointer-events: none;
  }

  .hero__name {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    transform: translate(-50%, -38%);
    width: max-content;
    max-width: calc(100% - 2 * var(--gutter));
    font-size: var(--t-hero);
    font-weight: 480;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 0;
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-align: center;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.35);
    translate: 0 calc(var(--p, 0) * -14vh);
  }

  .hero__row {
    display: inline-block;
    white-space: nowrap;
  }

  .hero__word:not(:last-child),
  .hero__row:not(:last-child) {
    margin-right: 0.27em;
  }

  .hero__word {
    display: inline-block;
    animation: word-in 1.6s calc(0.5s + var(--i) * 0.16s) var(--ease) both;
  }

  /* Darkens the photograph as the page scrolls away. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: calc(var(--p, 0) * 0.85);
    pointer-events: none;
  }

  .hero__line,
  .hero__cue {
    position: absolute;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
  }

  .hero__line {
    bottom: 5.75rem;
    width: max-content;
    max-width: calc(100% - 2 * var(--gutter));
    font-size: 0.9375rem;
    color: var(--c-text-2);
    text-align: center;
    animation: fade 1.6s 1.6s var(--ease) both;
  }

  .hero__cue {
    bottom: 1.6rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #fff;
    transition: opacity 0.25s;
    animation: fade 1.6s 2.1s var(--ease) both;
  }

  .hero__cue svg {
    animation: nudge 2.4s 3s ease-in-out infinite;
  }

  .hero__cue:hover {
    opacity: 0.6;
  }

  @media (max-width: 699px) {
    .hero__media img {
      object-position: var(--pos-m);
    }

    .hero__row {
      display: block;
    }

    .hero__row:not(:last-child) {
      margin-right: 0;
    }

    .hero__name {
      font-size: clamp(2.5rem, 13.5vw, 4.25rem);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.35em;
      filter: blur(14px);
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
