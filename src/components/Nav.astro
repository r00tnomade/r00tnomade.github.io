---
import { nav, site } from '../content/site';

interface Props {
  /** 'ink' for light photographs, 'light' for dark backgrounds. */
  tone?: 'ink' | 'light';
  /** Prefix for in-page anchors when used outside the home page. */
  base?: string;
}

const { tone = 'light', base = '' } = Astro.props;
const href = (h: string) => (h.startsWith('#') ? `${base}${h}` : h);
const all = [...nav.left, ...nav.right];
---

<header class:list={['nav', `nav--${tone}`]}>
  <nav class="nav__bar" aria-label="Main">
    <ul class="nav__group nav__group--left">
      {nav.left.map((item) => <li><a class="nav__link" href={href(item.href)}>{item.label}</a></li>)}
    </ul>
    <a class="nav__mark serif" href={base || '#top'} aria-label={`${site.name}, home`}>{site.name}</a>
    <ul class="nav__group nav__group--right">
      {nav.right.map((item) => <li><a class="nav__link" href={href(item.href)}>{item.label}</a></li>)}
    </ul>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu">
      <span class="visually-hidden">Menu</span>
      <span class="nav__bars" aria-hidden="true"></span>
    </button>
  </nav>

  <div class="menu" id="menu" hidden>
    <ul>
      {all.map((item) => <li><a class="menu__link serif" href={href(item.href)}>{item.label}</a></li>)}
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 800px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--c-text);
  }

  .nav--ink {
    color: var(--c-ink);
  }

  .nav__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(2rem, 5.6vw, 5rem);
    max-width: 1100px;
    margin-inline: auto;
    padding: 1.35rem var(--gutter);
    animation: nav-in 1.4s 0.9s var(--ease) both;
  }

  .nav__group {
    display: flex;
    gap: clamp(2rem, 5.6vw, 5rem);
  }

  .nav__group--left {
    justify-content: flex-end;
  }

  .nav__link {
    font-family: var(--f-label);
    font-stretch: 75%;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: opacity 0.25s;
  }

  .nav__mark {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__mark:hover {
    opacity: 0.6;
  }

  .nav__toggle {
    display: none;
  }

  .menu {
    display: none;
  }

  @media (max-width: 799px) {
    .nav__bar {
      grid-template-columns: 1fr auto;
      padding-block: 1.1rem;
    }

    .nav__group {
      display: none;
    }

    .nav__mark {
      font-size: 0.8125rem;
      position: relative;
      z-index: 2;
    }

    .nav__toggle {
      display: grid;
      place-items: center;
      position: relative;
      z-index: 2;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      background: none;
      border: 0;
      color: inherit;
      cursor: pointer;
    }

    .nav__bars,
    .nav__bars::after {
      display: block;
      width: 20px;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.35s var(--ease);
    }

    .nav__bars {
      position: relative;
      transform: translateY(-3.5px);
    }

    .nav__bars::after {
      content: '';
      position: absolute;
      top: 7px;
    }

    [aria-expanded='true'] .nav__bars {
      transform: rotate(45deg);
    }

    [aria-expanded='true'] .nav__bars::after {
      transform: translateY(-7px) rotate(-90deg);
    }

    :global(.menu-open) .nav {
      position: fixed;
      color: var(--c-text);
    }

    :global(.menu-open) {
      overflow: hidden;
    }

    .menu:not([hidden]) {
      display: flex;
      align-items: flex-end;
      position: fixed;
      inset: 0;
      z-index: 1;
      padding: 0 var(--gutter) 18vh;
      background: var(--c-black);
      animation: menu-in 0.45s var(--ease);
    }

    .menu ul {
      display: grid;
      gap: 0.4rem;
    }

    .menu__link {
      font-size: 2.75rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      translate: 0 -12px;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
</style>
