---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base title="Page not found">
  <Nav tone="light" base="/" />
  <main id="main" class="container missing">
    <h1 class="serif">Page not found</h1>
    <p>This page doesn’t exist or has moved.</p>
    <a class="text-link" href="/">Return to the home page</a>
  </main>
</Base>

<style>
  .missing {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1rem;
    min-height: 100svh;
    text-align: center;
  }

  h1 {
    font-size: var(--t-h1);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  p {
    color: var(--c-text-2);
  }
</style>
