---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Media from '../../components/Media.astro';
import Text from '../../components/Text.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Copy, type Fact, type Project } from '../../content/site';
import { projectMeta } from '../../lib/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : null },
  }));
}

interface Props {
  project: Project;
  next: Project | null;
}

const { project, next } = Astro.props;
const description = typeof project.summary === 'string' ? project.summary : undefined;

// Projects can set their own `facts`; otherwise build them from the fields they have.
const facts: Fact[] | undefined = project.facts;
const defaults: { label: string; value: Copy | Copy[] | undefined }[] = [
  { label: 'Type', value: projectMeta(project) },
  { label: 'Role', value: project.role },
  { label: 'Year', value: project.period },
  { label: 'Tools', value: project.tools },
];
---

<Base title={project.title} description={description}>
  <Nav tone="light" base="/" />

  <main id="main" class="detail">
    <header class="container detail__head">
      <a class="detail__back text-link" href="/#work">Back to selected work</a>
      <h1 class="detail__title serif">{project.title}</h1>
      {project.tagline && <p class="detail__tagline serif">{project.tagline}</p>}
      <p class="detail__summary"><Text value={project.summary} /></p>

      <dl class="detail__facts">
        {
          facts
            ? facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>
                    <span>
                      {f.value.map((part) =>
                        typeof part === 'string' ? (
                          part
                        ) : (
                          <a class="text-link" href={part.href} rel="noopener" target="_blank">{part.text}</a>
                        ),
                      )}
                    </span>
                  </dd>
                </div>
              ))
            : defaults
                .filter((f) => f.value !== undefined)
                .map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>
                      {(Array.isArray(f.value) ? f.value : [f.value!]).map((v) => (
                        <span>
                          <Text value={v} />
                        </span>
                      ))}
                    </dd>
                  </div>
                ))
        }
      </dl>
    </header>

    <div class="container--wide detail__media">
      <Media image={project.image} ratio="16 / 9" sizes="(max-width: 1280px) 94vw, 1200px" widths={[640, 960, 1400, 1920]} eager />
    </div>

    <article class="container detail__body">
      {
        project.sections.map((s) => (
          <section class="detail__section">
            <h2 class="detail__heading serif">{s.heading}</h2>
            <div class="detail__content">
              {(s.body ?? []).map((p) => (
                <p>
                  <Text value={p} />
                </p>
              ))}
              {
                s.layers && (
                  <ul class="layers">
                    {s.layers.map((l) => (
                      <li class="layers__item">
                        <div class="layers__head">
                          <span class="layers__name serif">{l.name}</span>
                          <span class="layers__rate">{l.rate}</span>
                        </div>
                        <p>{l.body}</p>
                      </li>
                    ))}
                  </ul>
                )
              }
              {
                s.results && (
                  <dl class="results">
                    {s.results.map((r) => (
                      <div class="results__item">
                        <dt class="results__value serif">{r.value}</dt>
                        <dd class="results__label">{r.label}</dd>
                      </div>
                    ))}
                  </dl>
                )
              }
            </div>
          </section>
        ))
      }
      {
        project.links && project.links.length > 0 && (
          <section class="detail__section">
            <h2 class="detail__heading serif">Links</h2>
            <ul class="detail__links">
              {project.links.map((l) => (
                <li>
                  <a class="text-link" href={l.href} rel="noopener" target="_blank">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>

    {
      next && (
        <nav class="container detail__next" aria-label="Next project">
          <span class="head-line" aria-hidden="true" />
          <p class="detail__next-label">Next project</p>
          <a class="detail__next-title serif" href={`/work/${next.slug}/`}>
            {next.title}
          </a>
        </nav>
      )
    }
  </main>

  <Footer />
</Base>

<style>
  .detail__head {
    padding-top: clamp(8rem, 14vw, 10.5rem);
  }

  .detail__back {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--c-text-2);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .detail__title {
    font-size: var(--t-h1);
    font-weight: 600;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 0;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .detail__tagline {
    margin-top: 1.25rem;
    font-size: var(--t-lead);
    font-weight: 500;
    font-variation-settings: 'opsz' 36, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }

  .detail__summary {
    max-width: 40rem;
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    color: var(--c-text-2);
  }

  .detail__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .detail__facts div {
    padding-top: 1rem;
    border-top: 1px solid var(--c-line-strong);
  }

  .detail__facts dt {
    font-size: var(--t-small);
    color: var(--c-text-3);
    margin-bottom: 0.35rem;
  }

  .detail__facts dd {
    display: grid;
    font-size: 0.9375rem;
  }

  .detail__media {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .detail__media :global(.media) {
    border-radius: var(--r-card);
  }

  .detail__body {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .detail__section {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 1rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--c-line);
  }

  .detail__heading {
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings: 'opsz' 48, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .detail__section p {
    max-width: 38rem;
    color: var(--c-text-2);
  }

  .detail__section p + p {
    margin-top: 1rem;
  }

  .layers {
    margin-top: 2rem;
  }

  .layers__item {
    padding-block: 1.4rem;
    border-top: 1px solid var(--c-line);
  }

  .layers__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.45rem;
  }

  .layers__name {
    font-size: 1.375rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 36, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.01em;
  }

  .layers__rate {
    font-size: var(--t-small);
    color: var(--c-text-3);
    font-variant-numeric: tabular-nums;
  }

  .layers__item p {
    max-width: 34rem;
  }

  .results {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem clamp(1.5rem, 3vw, 2.5rem);
  }

  .results__value {
    font-size: clamp(2.25rem, 4.2vw, 3.25rem);
    font-weight: 600;
    font-variation-settings: 'opsz' 96, 'SOFT' 0, 'WONK' 0;
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 0.7rem;
  }

  .results__label {
    margin: 0;
    max-width: 18rem;
    font-size: 0.9375rem;
    color: var(--c-text-2);
  }

  .detail__links {
    display: grid;
    gap: 0.6rem;
  }

  .detail__next {
    display: grid;
    justify-items: center;
    text-align: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .head-line {
    width: 1px;
    height: clamp(80px, 9vw, 128px);
    margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.32) 50%, transparent);
  }

  .detail__next-label {
    font-size: 0.875rem;
    color: var(--c-text-3);
    margin-bottom: 0.6rem;
  }

  .detail__next-title {
    font-size: var(--t-h2);
    font-weight: 600;
    font-variation-settings: 'opsz' 72, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.03em;
    transition: opacity 0.25s;
  }

  .detail__next-title:hover {
    opacity: 0.65;
  }

  @media (max-width: 799px) {
    .detail__facts {
      grid-template-columns: repeat(2, 1fr);
    }

    .detail__section {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 599px) {
    .results {
      grid-template-columns: 1fr;
    }
  }
</style>
